{
  "loginIndicator": "/join",
  "nav": {
    "containerSelector": "nav[class*='awsui_navigation']",
    "itemSelector": "a[href]",
    "groupSelector": "[class*='awsui_expandable-link-group']",
    "groupTitleSelector": "[class*='awsui_header-navigation']"
  },
  "includeBasePage": true,
  "basePageTitle": "Overview",
  "hideSelectors": [
    "nav[class*='awsui_navigation']",
    "[class*='awsui_navigation-container']",
    "[class*='awsui_navigation-toggle']",
    "[class*='awsui_breadcrumb']",
    "header[class*='awsui_top-navigation']",
    "[class*='AppTopNavigation']",
    "[class*='Footer-module']",
    "[class*='awsui_tools']",
    "[class*='awsui_drawer']",
    "[class*='awsui_flashbar']",
    "[class*='awsui_flash']",
    "[class*='awsui_notifications']"
  ],
  "widenSelectors": [
    "[class*='awsui_content-wrapper']",
    "[class*='awsui_content']",
    "main"
  ],
  "waitFor": "networkidle",
  "pdfOptions": {
    "format": "A4",
    "printBackground": true,
    "margin": { "top": "15mm", "bottom": "15mm", "left": "12mm", "right": "12mm" }
  }
}
